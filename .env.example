# HTTP port used by the canonical FastAPI runtime.
PORT=8000

# Canonical API configuration. Protect every non-health endpoint with a strong bearer token.
NEXUS_API_PORT=8000
NEXUS_API_BASE_URL=http://127.0.0.1:8000
NEXUS_API_LOG_LEVEL=warning
NEXUS_API_BEARER_TOKEN=

# SQLite persists across process restarts when this path is on a durable volume.
# Set NEXUS_STORAGE_DURABLE=true only after verifying the host mounts persistent storage.
NEXUS_STORAGE_DURABLE=false
# SQLite is single-node storage; use a PostgreSQL repository for multi-instance scale.
NEXUS_OPERATIONAL_DB_PATH=./data/nexus_operational.db
# Separate legacy analytics tables from the canonical runtime journal schema.
NEXUS_LEGACY_DB_PATH=./data/nexus_legacy.db

# OAuth account connections. Configure only providers that officially support OAuth.
# NEXUS_OAUTH_PROVIDERS is JSON metadata (endpoints, scopes and names); client IDs
# and secrets are separate environment variables stored in your deployment's secret manager.
# Generate the encryption key with Fernet.generate_key() and store it only as a secret.
NEXUS_OAUTH_PROVIDERS={}
NEXUS_OAUTH_REDIRECT_URI=
NEXUS_CONNECTION_ENCRYPTION_KEY=

# Playwright navigation is read-only and limited to this allowlist. It cannot log in,
# fill forms, place bets, trade, or submit payments. Add only platforms to inspect.
NEXUS_BROWSER_ALLOWED_HOSTS=upwork.com,fiverr.com,clickworker.com,prolific.com,amazon.com,shopify.com,alibaba.com,ebay.com,1xbet.com,metatrader5.com,mql5.com

# Official AI connectors: leave blank until configured through the provider's
# supported account and API mechanism. Values must never be committed.
NEXUS_OPENAI_API_KEY=
NEXUS_OPENAI_MODEL=gpt-4o-mini
NEXUS_OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions
NEXUS_GEMINI_API_KEY=
NEXUS_GEMINI_MODEL=gemini-2.0-flash
NEXUS_GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent
NEXUS_ANTHROPIC_API_KEY=
NEXUS_ANTHROPIC_MODEL=claude-3-5-haiku-latest
NEXUS_ANTHROPIC_ENDPOINT=https://api.anthropic.com/v1/messages

# Optional code-adaptation workflow: creates draft PRs only; never edits the live process or auto-merges.
NEXUS_GITHUB_REPOSITORY=
NEXUS_GITHUB_TOKEN=
NEXUS_GITHUB_BASE_BRANCH=main

# Nexus does not own a wallet. Never store card PAN/CVV, provider secrets, cookies, or passwords here.
